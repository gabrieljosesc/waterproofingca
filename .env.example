# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). The contact and estimate forms work in demo mode
# without the service-role key, but nothing is persisted until it is set.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Server-only, used by the /api/quote and /api/estimate routes to write leads.
# Bypasses row-level security — never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for the AI photo analysis (/api/estimate/[id]/analyze).
# Pay-as-you-go; get it from console.anthropic.com. Server-only, keep secret.
# Without it, analysis is skipped and submissions still land for manual review.
ANTHROPIC_API_KEY=sk-ant-...

# --- Email (Resend, https://resend.com — free tier is plenty) ---
# Without RESEND_API_KEY, emails are skipped (logged) and every flow still works.
RESEND_API_KEY=re_...
# Sender. Until you verify a domain in Resend, leave unset (defaults to
# onboarding@resend.dev, which can only deliver to the Resend account owner).
# After verifying: "DryFort Waterproofing <quotes@yourdomain.ca>"
EMAIL_FROM=
# Where new-lead alerts go (owner's inbox).
OWNER_ALERT_EMAIL=owner@example.com
# Base URL used for dashboard links inside alert emails.
APP_BASE_URL=http://localhost:3000

# Optional. Used to encrypt the short-lived full card payload so admins can
# reveal it in /admin/[id]. If unset, SUPABASE_SERVICE_ROLE_KEY is used as the
# key material. Prefer setting a dedicated long random secret in production.
CARD_VAULT_SECRET=

# --- Google Analytics 4 + Google Ads conversion tracking ---
# Without NEXT_PUBLIC_GA_MEASUREMENT_ID, no tag is loaded and tracking calls
# are no-ops. These are all public (NEXT_PUBLIC_) — they're visible in the
# page source, same as any analytics tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads account ID (format AW-XXXXXXXXX), from Google Ads > Tools >
# Conversions. Only needed once you're also running paid ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels from the two conversion actions created in Google Ads
# (Tools & Settings > Conversions > + New conversion action):
# one for "estimate submitted" (a lead) and one for "quote accepted" (the
# stronger, deposit-intent conversion). Each label looks like AbC-D_efG-h1i2.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_ACCEPT_LABEL=
