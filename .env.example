# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). The quote form works in demo mode without these,
# but leads are only persisted when they are set.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key used by /api/quote (never expose this in the browser):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
