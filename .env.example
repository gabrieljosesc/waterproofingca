# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). The contact and estimate forms work in demo mode
# without the service-role key, but nothing is persisted until it is set.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Server-only, used by the /api/quote and /api/estimate routes to write leads.
# Bypasses row-level security — never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for the AI photo analysis (/api/estimate/[id]/analyze).
# Pay-as-you-go; get it from console.anthropic.com. Server-only, keep secret.
# Without it, analysis is skipped and submissions still land for manual review.
ANTHROPIC_API_KEY=sk-ant-...
